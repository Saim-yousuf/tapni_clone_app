<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/caller_id_card_bg"
        android:elevation="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="10dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/caller_id_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Barqody Caller ID"
                android:textColor="#25D366"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/caller_id_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingTop="2dp"
                android:textColor="#111B21"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/caller_id_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:paddingTop="2dp"
                android:textColor="#667781"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/caller_id_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="×"
            android:textColor="#667781"
            android:textSize="26sp" />
    </LinearLayout>
</FrameLayout>
