  checkGoogleStatus() async {
    final bool googleLoggedIn = await _googleSignIn.isSignedIn();
    PrintLog.logMessage("googleLoggedIn: $googleLoggedIn");
    isGoogleLogin = googleLoggedIn;
    notifyListeners();
  }
}